    ''Testing Passages''
    <<btnLink "Men's Store" "Mens-Store">>\
    <hr>
<</if>>\

''Options:''
<hr>
<<btnLink "Test Conversations and Events" "dbg_Events">>
<<btnLink "Test Dreams" "debug_Dreams">>
<<btnLink "Character Creation" "debug_CharacterCreation">>
