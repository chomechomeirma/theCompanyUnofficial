						<<SetFlag $penny "unlockApartment">>\
						<<btnLink "Go with $penny.name" "Penny-Apartment">>
					<</replace>>\
				<</button>>@@
				@@.btnChoice;<<button "Decline">>
					<<replace "#pennylift">>\
						<<nm $player "I'm a little busy tonight, $penny.name. Maybe another time?">>\
						
