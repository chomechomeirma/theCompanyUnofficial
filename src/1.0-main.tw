	<<else>>\
		''The doors close and the lift heads upward.''
	<</if>>\

	''You look over at $penny.name.''

	<<nm $player "Well, $penny.name, let's get to work.">>\

	<<btnLink "To the lab!" "Lab" "setTime('lm')">>


