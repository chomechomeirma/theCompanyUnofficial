    <<if $tasha.isDating>>\
        <<btnChoice "Bring $tasha.name over for dinner" "ChristmasPlans-Tasha">>\
    <</if>>\
    <<if $sophie.isDating>>\
        <<btnChoice "Bring $sophie.name over for dinner" "ChristmasPlans-Sophie">>\
    <</if>>\
    <<if $john.isDating>>\
        <<btnChoice "Bring $john.name over for dinner" "ChristmasPlans-John">>\
    <</if>>\
    <<btnChoice "Bring $chris.name over for dinner" "ChristmasPlans-Chris">>\


