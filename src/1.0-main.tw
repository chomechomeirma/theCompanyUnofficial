:: Intro-Home2 {"position":"975,22350","size":"100,100"}
<<loc_LivingRoom true>>\

	<<if $c is 1>>\
		<<artB $sister "angry,2">>\
	<<elseif $c is 2>>\
		<<artB $sister "embarrassed,2">>\
	<<else>>\
		<<artB $sister "default,2">>\
	<</if>>\
	<<switch $c>>\
