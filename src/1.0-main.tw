:: NotebookEntry {"position":"975,13975","size":"100,100"}
<<nobr>>\
		<<switch $c>>
			<<case "mom">>
				<<set $subject to $mom>>
			<<case "sister">>
				<<set $subject to $sister>>
			<<case "sophie">>
				<<set $subject to $sophie>>
			<<case "penny">>
				<<set $subject to $penny>>
			<<case "tasha">>
				<<set $subject to $tasha>>
			<<case "john">>
				<<set $subject to $john>>
			<<case "diana">>
				<<set $subject to $diana>>
			<<case "julia">>
				<<set $subject to $julia>>
			<<case "kagney">>
				<<set $subject to $kagney>>
			<<case "lisa">>
				<<set $subject to $lisa>>
			<<case "lauren">>
				<<set $subject to $lauren>>
			<<case "james">>
				<<set $subject to $james>>
			<<case "saya">>
				<<set $subject to $saya>>
			<<case "chris">>
				<<set $subject to $chris>>
			<<case "ash">>
				<<set $subject to $ash>>
			<<case "lexi">>
				<<set $subject to $lexi>>
			<<case "siri">>
				<<set $subject to $siri>>
			<<case "veruca">>
				<<set $subject to $veruca>>
		<</switch>>
		<<set _actor to $subject>>
	<</nobr>>\
	<<if detectMobile()>>\
		<<if $UseArt>>\
			<<set _n to _actor.id + "/notes/" + _actor.default>>\
			<<art _n>>\
		<<elseif not _actor.default>>\
			<<img "notes" _actor.id>>\
		<<elseif _actor is $lauren>>\
			<<img "notes" "lauren">>\
		<<elseif _actor is $lisa>>\
			<<img "notes" "lisa">>\
		<<elseif _actor is $kagney>>\
			<<if not $kagney.noteImg>>\
				<<img "notes" "kagney">>\
			<<else>>\
				<<pic $kagney $kagney.noteImg>>\
			<</if>>\
		<<else>>\
			<<set _noteImg to _actor.default + "-note">>\
			<<pic _actor _noteImg>>\
		<</if>>\
		
		@@.form;
		''Name:''
		_actor.name
		
		''Connection:''
		_actor.relationship
		
		''Status:''
		<<print _actor.status>>

		''Affection:''
		<<ShowAffection _actor "" "love">>

		''Corruption:''
		<<ShowAffection _actor "" "lust">>
	
		<<if _actor.isPregnant>>\
			_actor.name is @@.xxx;pregnant@@, having been inseminated by _actor.pregnantBy
		<</if>>\
		@@
	<<else>>\
		<div class="row">\
			<div class="column-50">\
				@@.form;
				''Name:''
				_actor.name
				
				''Connection:''
				_actor.relationship
				
				''Status:''
				<<print _actor.status>>

				''Affection:''
				<<ShowAffection _actor "" "love">>

				''Corruption:''
				<<ShowAffection _actor "" "lust">>
			
				<<if _actor.isPregnant>>\
					_actor.name is @@.xxx;pregnant@@, having been inseminated by _actor.pregnantBy
				<</if>>\
				@@
			</div>\
			<div class="column-50">\
				<<if $UseArt>>\
					<<set _n to _actor.id + "/notes/" + _actor.default>>\
					<<art _n>>\
				<<elseif not _actor.default>>\
					<<img "notes" _actor.id>>\
				<<elseif _actor is $lauren>>\
					<<img "notes" "lauren">>\
				<<elseif _actor is $lisa>>\
					<<img "notes" "lisa">>\
				<<elseif _actor is $kagney>>\
					<<if not $kagney.noteImg>>\
						<<img "notes" "kagney">>\
					<<else>>\
						<<pic $kagney $kagney.noteImg>>\
					<</if>>\
				<<else>>\
					<<set _noteImg to _actor.default + "-note">>\
					<<pic _actor _noteImg>>\
				<</if>>\
			</div>\
		</div>\
	<</if>>\
	<hr>

	<<for _i=0; _i < _actor.notes.length; _i++>>\
		<<if _actor.notes[_i]>>\
			<<set _note to _actor.notes[_i].split(" - ")>>\
			<<set _noteTitle to _note[0] + " - " + _note[1]>>\
			<<set _noteBody to _note[2]>>\
			<<nmc "_noteTitle" "_noteBody" "Note">>
		<</if>>\
	<</for>>\

	<<btnLink "Go back" "Notebook" "$c=0">>


