			<<nm $player "Hey <<sis>>, you're looking cute today.">>\

			''$sister.name tenses up and blushes, trying her best to look irritated.''

			<<nm $sister "D-don't be weird! Jeez, the hell is that supposed to mean...">>\

			<<love $sister 1>>
