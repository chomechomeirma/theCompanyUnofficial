<<widget "CommentPenis">>
    <<if $args[0]>>
        <<set _actor to $args[0], _msg to "">>

        <<if pTier() is 5>>
            <<if $args[1]>>
                <<set _msg to $args[1]>>
            <</if>>
        <<elseif pTier() is 4>>
            <<if $args[2]>>
                <<set _msg to $args[2]>>
            <<else>>
                <<set _msg to $args[1]>>
            <</if>>
        <<elseif pTier() is 3>>
            <<if $args[3]>>
