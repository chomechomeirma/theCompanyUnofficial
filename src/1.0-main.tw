<<else>>\
	<<if flag($player,"JagDead")>>\
		''$mick.name silently drives you to work.''

		<<Thought "No $jag.name today?">>\
	<<elseif flag($player,"JagGone")>>\
		''$mick.name silently drives you to work.''
	<<else>>\
