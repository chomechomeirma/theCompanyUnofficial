:: dbg_Shop {"position":"1100,1475","size":"100,100"}
<<pic $npc "ash">>\

    <<if firstVisit()>>\
        <<nm $player "Hello?">>\

        ''There's a cute blond working the counter.''

        <<nm $ash "What's up, name's $ash.name. Let me know if you need anything.">>\
    <<else>>\
        <<nm $player "Hey $ash.name.">>\

