            <<else>>
                <<set _msg to $args[3]>>
            <</if>>
        <<elseif pTier() is 1>>
            <<if $args[5]>>
                <<set _msg to $args[5]>>
            <<else>>
                <<set _msg to $args[4]>>
            <</if>>
        <<else>>
            <<set _msg to "Invalid PSize Comment">>
        <</if>>
        
        <<if _msg.contains("|")>>
            <<set _mt to _msg.split("|")>>
            <<nm _actor _mt[0] _mt[1]>>
        <<else>>
            <<nm _actor _msg>>
        <</if>>
    <</if>>
