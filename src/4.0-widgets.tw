				/* Draw Player Base */
				<<= '<img class="pa1" src="' + _doll + '">'>>
				<<= '<img class="pa1" src="' + _dollHead + _ex[1] + '.png">'>>
				<<= '<img class="pa1" src="' + _dollHair + '">'>>
				<<= '<img class="pa1" src="' + _dollFeet + '">'>>
				<<= '<img class="pa1" src="' + _dollCrotch + '">'>>
